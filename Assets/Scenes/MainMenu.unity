  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC624\uB79C \uD658\uACBD \uD30C\uAD34\uC640 \uC790\uC6D0 \uACE0\uAC08\uB85C
    \uC778\uD574 \uB354 \uC774\uC0C1 \uD604\uC7AC\uC758 \uD589\uC131\uC5D0\uC11C
    \uC0DD\uC874\uD560 \uC218 \uC5C6\uAC8C \uB418\uC5C8\uB2E4. \r\n\\n\\n\uD589\uC131\uC740
    \uD604\uC7AC \uC885\uB9D0\uC5D0 \uC784\uBC15\uD55C \uC0C1\uD669\r\n\\n\\n\uC720\uC77C\uD558\uAC8C
    \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB358 \uD50C\uB808\uC774\uC5B4\uB294 \uB9C8\uC9C0\uB9C9
    \uD0D0\uC0AC\uC120\uC5D0\uC11C \uD76C\uB9DD\uC758 \uC2E4\uB9C8\uB9AC\uB97C \uCC3E\uC558\uB2E4.\r\n\\n\\n\uBA87
    \uAD11\uB144 \uB5A8\uC5B4\uC9C4 \uBBF8\uC9C0\uC758 \uD589\uC131 Eden-25 \uC5D0\uC11C
    \uBC1C\uACAC\uB41C \uC2E0\uD638\uB294 \uC0DD\uBA85\uCCB4\uAC00 \uC874\uC7AC\uD560
    \uAC00\uB2A5\uC131\uC744 \uC554\uC2DC\uD588\uB2E4.\r\n\\n\\n\uADF8\uB7EC\uB098
    Eden-25\uAC00 \uC0DD\uC874 \uAC00\uB2A5\uD55C \uD658\uACBD\uC778\uC9C0, \uC801\uB300\uC801\uC778
    \uC874\uC7AC\uAC00 \uC788\uB294\uC9C0,\r\n\\n\uB610\uB294 \uAC70\uC8FC\uC9C0\uB85C
    \uC801\uD569\uD558\uC9C0 \uC54A\uC740 \uD658\uACBD\uC778\uC9C0\uB294 \uC54C \uC218
    \uC5C6\uB2E4.\r\n\\n\\n\uD50C\uB808\uC774\uC5B4\uB294 \uC774 \uC704\uD0DC\uB85C\uC6B4
    \uC0C1\uD669\uC5D0\uC11C \uBBF8\uC644\uC131\uB41C \uC6B0\uC8FC\uC120\uC744 \uD0C0\uACE0
    \uB5A0\uB098\uBA70, \uC120\uD0DD\uACFC \uC0DD\uC874\uC758 \uC5EC\uC815\uC5D0
    \uB098\uC11C\uAC8C \uB41C\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 592bb715b5a65794ca9bdf2e660f1527, type: 2}
